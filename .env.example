# Copy to .env and adjust. NEVER commit real secrets.

# SQLite database file (created on first inference run)
DATABASE_PATH=backend/data/app.db

# CORS for the Vite dev server / static frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server
HOST=127.0.0.1
PORT=8000

# Artifacts / model locations (relative to project root)
ARTIFACTS_DIR=artifacts
MODELS_DIR=models

# Real AWS blocking is DISABLED by default. The response engine runs in
# SIMULATED mode only. Enabling this requires boto3 + real credentials and
# is a proposed future integration - see README.
AWS_REAL_BLOCKING_ENABLED=false
